{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@snapscale/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "drizzle.config.ts"]
}
