# Copy to .env for local development; compose injects the real values in
# containers. Every var here is validated by src/config.ts at boot — missing
# or invalid values crash the process with the offending field name.

PORT=4000
DATABASE_URL=postgres://snapscale:snapscale@localhost:5432/snapscale_api
SMTP_HOST=localhost
SMTP_PORT=1025
JWT_SECRET=change-me-in-every-environment
OTP_TTL_SECONDS=600
UPLOAD_DIR=./data/uploads
