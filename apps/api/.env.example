# Copy to .env for local development; compose injects the real values in
# containers. Every var here is validated by src/config.ts at boot — missing
# or invalid values crash the process with the offending field name.

PORT=4000
# Host port 5433 (not 5432) and db `snapscale` — both come straight from
# docker-compose.yml; 5432 is deliberately left free for any other local server.
DATABASE_URL=postgres://snapscale:snapscale@localhost:5433/snapscale
SMTP_HOST=localhost
SMTP_PORT=1025
JWT_SECRET=change-me-in-every-environment
OTP_TTL_SECONDS=600
UPLOAD_DIR=./data/uploads
# Browser origin allowed to call this api (the Vite dev server).
WEB_ORIGIN=http://localhost:5173
