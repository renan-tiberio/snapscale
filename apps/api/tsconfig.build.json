{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@snapscale/tsconfig/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "noEmit": false,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
