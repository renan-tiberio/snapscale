{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@snapscale/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "include": ["src", "vite.config.ts", ".storybook/main.ts", ".storybook/preview.ts"]
}
